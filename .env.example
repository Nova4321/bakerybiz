# ============================================
# BakeryBiz — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# PostgreSQL connection string (required)
# Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/bakerybiz

# Port for the API server (Railway sets this automatically)
PORT=5000

# Node environment
NODE_ENV=production

# Frontend URL — used for CORS configuration
# Set this to your Vercel deployment URL after deploying
FRONTEND_URL=https://your-app.vercel.app
